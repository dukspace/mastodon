# Compose interpolation only. Never put application secrets here.
# Replace the placeholder with the FULL SHA verified on Staging.
MASTODON_IMAGE_TAG=sha-REPLACE_WITH_40_CHARACTER_COMMIT_SHA
PRODUCTION_ENV_FILE=/etc/mastodon-production/runtime.env
RDS_CA_FILE=/etc/mastodon-production/rds-ca.pem

# Match the existing systemd configuration initially; tune after measuring load.
WEB_CONCURRENCY=2
MAX_THREADS=5
SIDEKIQ_CONCURRENCY=25
